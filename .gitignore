# ==============================================================================
# 🌾 农作物单产预测与统计去偏系统 (crop_yield_pipeline) Git 忽略规则
# ==============================================================================

# --- 1. 遥感大文件与栅格数据 ---
*.tif
*.tiff
*.TIF
*.TIFF
*.img
*.nc
*.hdf
*.h5

# --- 2. 动态运行生成产物目录 ---
output/*
!output/.gitkeep

# --- 3. Python 运行与编译缓存 ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- 4. 虚拟环境 ---
venv/
.venv/
env/
ENV/

# --- 5. IDE 与临时文件 ---
.idea/
.vscode/
.DS_Store
Thumbs.db
[Dd]esktop.ini
